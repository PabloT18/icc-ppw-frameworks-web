---
// src/pages/dashboard.astro
// Módulo 11 — Página protegida de administración

import BaseLayout from "../layouts/BaseLayout.astro";

// Defensa en profundidad: el middleware ya redirige, pero verificamos igualmente
if (!Astro.locals.autenticado) {
    return Astro.redirect("/login");
}
---

<BaseLayout titulo="Dashboard">
    <h1>Panel de administración</h1>
    <p class="bienvenida">Sesión activa. Acceso concedido.</p>

    <ul class="acciones">
        <li><a href="/recursos/1">Ver recursos</a></li>
        <li><a href="/blog">Ver blog</a></li>
        <li><a href="/contacto">Formulario de contacto</a></li>
        <li><a href="/favoritos">Mis favoritos</a></li>
    </ul>

    <form method="POST" action="/api/auth/logout" class="logout-form">
        <button type="submit" class="btn-logout">Cerrar sesión</button>
    </form>
</BaseLayout>

<style>
    .bienvenida {
        color: var(--color-text-muted, #aaa);
        margin-bottom: 1.5rem;
    }
    .acciones {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    .acciones a {
        color: var(--color-brand, #ff5d01);
        text-decoration: none;
    }
    .acciones a:hover {
        text-decoration: underline;
    }
    .logout-form {
        margin-top: 2rem;
    }
    .btn-logout {
        background: none;
        border: 1px solid var(--color-error, #f87171);
        border-radius: var(--radius-md, 0.5rem);
        color: var(--color-error, #f87171);
        cursor: pointer;
        font-size: 0.95rem;
        padding: 0.5rem 1.25rem;
        transition:
            background 0.2s,
            color 0.2s;
    }
    .btn-logout:hover {
        background: var(--color-error, #f87171);
        color: #fff;
    }
</style>
