---
// src/pages/404.astro
// Módulo 03 — Página de error 404 personalizada

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout titulo="Página no encontrada">
    <div class="error-container">
        <h1>404</h1>
        <p>La página que buscas no existe o fue movida.</p>
        <a href="/">← Volver al inicio</a>
    </div>
</BaseLayout>

<style>
    .error-container {
        text-align: center;
        padding: 5rem 0;
    }
    h1 {
        font-size: 7rem;
        color: #ff5d01;
        margin: 0;
        line-height: 1;
    }
    p {
        font-size: 1.2rem;
        color: #aaa;
        margin: 1rem 0 2rem;
    }
    a {
        color: #ff5d01;
        text-decoration: none;
        font-weight: 600;
        border: 1px solid #ff5d01;
        padding: 0.5rem 1.25rem;
        border-radius: 0.375rem;
    }
    a:hover {
        background: #ff5d01;
        color: #0f0f0f;
    }
</style>
