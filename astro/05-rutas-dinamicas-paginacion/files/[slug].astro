---
// src/pages/recursos/[slug].astro
// Módulo 05 — Página de detalle de recurso

import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/Badge.astro";
import { recursos } from "../../data/recursos";
import type { Recurso } from "../../data/recursos";

export function getStaticPaths() {
    return recursos.map((r) => ({
        params: { slug: r.slug },
        props: { recurso: r },
    }));
}

interface Props {
    recurso: Recurso;
}

const { recurso } = Astro.props;

// Mapa de categoria a variante de Badge
const categoriaVariante: Record<
    Recurso["categoria"],
    "info" | "exito" | "advertencia" | "error"
> = {
    Framework: "info",
    Referencia: "exito",
    Herramienta: "advertencia",
    Comunidad: "error",
};
---

<BaseLayout titulo={recurso.titulo} descripcion={recurso.descripcion}>
    <nav class="breadcrumb">
        <a href="/recursos/1">← Recursos</a>
    </nav>

    <article class="detalle">
        <header>
            <Badge
                texto={recurso.categoria}
                variante={categoriaVariante[recurso.categoria]}
            />
            <h1>{recurso.titulo}</h1>
            <p class="descripcion">{recurso.descripcion}</p>
        </header>

        <a
            href={recurso.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-visit"
        >
            Visitar sitio →
        </a>
    </article>
</BaseLayout>

<style>
    .breadcrumb {
        margin-bottom: 2rem;
        font-size: 0.9rem;
    }
    .detalle header {
        margin-bottom: 2rem;
    }
    .detalle h1 {
        margin-top: 0.75rem;
    }
    .descripcion {
        font-size: 1.1rem;
        color: var(--color-text-muted, #aaa);
        line-height: 1.7;
    }
    .btn-visit {
        display: inline-block;
        background: var(--color-brand, #ff5d01);
        color: #fff;
        padding: 0.75rem 2rem;
        border-radius: var(--radius-md, 0.5rem);
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.2s;
    }
    .btn-visit:hover {
        opacity: 0.85;
    }
</style>
