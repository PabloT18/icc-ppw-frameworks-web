---
// src/components/FavButton.astro
// Módulo 08 — Botón de favoritos con localStorage

interface Props {
    slug: string;
}
const { slug } = Astro.props;
---

<button
    class="fav-btn"
    data-slug={slug}
    aria-label="Agregar a favoritos"
    title="Agregar a favoritos"
>
    ☆
</button>

<script>
    const STORAGE_KEY = "campus-favoritos";

    function getFavs(): string[] {
        try {
            return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
        } catch {
            return [];
        }
    }

    function updateBtn(btn: HTMLButtonElement, esFav: boolean) {
        btn.textContent = esFav ? "★" : "☆";
        btn.setAttribute(
            "aria-label",
            esFav ? "Quitar de favoritos" : "Agregar a favoritos",
        );
        btn.title = esFav ? "Quitar de favoritos" : "Agregar a favoritos";
        btn.classList.toggle("activo", esFav);
    }

    // Inicializar todos los botones en la página
    document.querySelectorAll<HTMLButtonElement>(".fav-btn").forEach((btn) => {
        const slug = btn.dataset.slug!;
        updateBtn(btn, getFavs().includes(slug));

        btn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            const favs = getFavs();
            const idx = favs.indexOf(slug);
            if (idx === -1) favs.push(slug);
            else favs.splice(idx, 1);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(favs));
            updateBtn(btn, idx === -1);
        });
    });
</script>

<style>
    .fav-btn {
        background: none;
        border: 1px solid var(--color-border, #333);
        border-radius: var(--radius-sm, 0.25rem);
        color: var(--color-text-muted, #aaa);
        cursor: pointer;
        font-size: 1.1rem;
        padding: 0.25rem 0.5rem;
        transition:
            color 0.2s,
            border-color 0.2s;
        line-height: 1;
    }
    .fav-btn:hover {
        border-color: var(--color-brand, #ff5d01);
        color: var(--color-brand, #ff5d01);
    }
    .fav-btn.activo {
        color: #f59e0b;
        border-color: #f59e0b;
    }
</style>
